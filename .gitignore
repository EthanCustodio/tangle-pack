# .gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.coverage
.eggs/
build/
dist/
.vscode/
.idea/
*.log
.env/
.venv/
env/
venv/

# profiling output
profile.out

# local Claude Code state
.claude/settings.local.json
.claude/worktrees/

# refactor proof figures: PNGs and data are tracked, the heavy SVG/pickle copies stay local
figures/refactor_proof/**/*.svg
figures/refactor_proof/**/*.fig.pickle

# Athanor sigil run state (runtime)
.claude/athanor/state/

# workflow scratch inside a worktree (/refactor, /feature)
.plan.md
.base-cov.json
.cand-cov.json

# k25 entropy rerun: PNGs, READMEs and summaries are tracked, the heavy SVG/pickle copies and the sweep data stay local
figures/henon_k25_entropy_post_array_refactor/**/*.svg
figures/henon_k25_entropy_post_array_refactor/**/*.fig.pickle
figures/henon_k25_entropy_post_array_refactor/**/*.json
