/* ===========================================================
   TanglePack WebDash Styles (modular version)
   -----------------------------------------------------------
   This stylesheet assumes:
   - Two-column layout: .sidebar (left) + .main (right)
   - Modular sections: system-section, fp-section, manifold-section, etc.
   - Shared control class: .controls
   =========================================================== */

/* ===== Global Theme Variables ===== */
:root {
  --bg: #0f0f13;            /* page background */
  --fg: #e6e6ea;            /* primary text */
  --muted: #9b9ca0;         /* secondary text */

  /* Accent and control panel colors */
  --panel-bg:   #262033;    /* neutral purple-gray */
  --panel-border: #3b2f5a;
  --panel-accent: #7c3aed;  /* indigo accent */

  --input-bg: #1a1525;
  --input-border: #5b21b6;
  --input-focus: rgba(124,58,237,0.35);
  --button-bg: #6d28d9;
  --button-bg-hover: #7c3aed;
  --button-text: #fff;

  --graph-surface: #1e1e22;
  --graph-border:  #2a2a31;
}

/* ===== Base Page ===== */
html, body {
  height: 100%;
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
body { overflow: hidden; }

/* ===========================================================
   APP LAYOUT GRID
   =========================================================== */

.app {
  display: grid;
  grid-template-columns: 360px 1fr;
  height: 100vh;
}

/* Sidebar: scrollable column with modular sections */
.sidebar {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding: 10px;
  gap: 12px;
  box-sizing: border-box;
}

.sidebar h3 {
  margin: 4px 0 8px;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--fg);
}

/* Main: plot container */
.main {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  overflow: hidden;
}

/* ===========================================================
   CONTROLS SECTIONS
   =========================================================== */

/* Each section: fixed color block */
.controls {
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 10px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}

/* Slight variation for each section (for visual grouping) */
.system-section    { background: #221b2f; }
.fp-section        { background: #241e37; }
.orientation-section { background: #271f40; }
.manifold-section  { background: #2a2148; }
.bridge-section    { background: #2d2450; }
.click-section     { background: #302759; }

/* Inputs */
.controls input[type="text"],
.controls input[type="number"],
.controls input[type="search"] {
  background: var(--input-bg);
  color: var(--fg);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 6px;
  padding: 6px 8px;
  transition: border-color .15s, box-shadow .15s;
}
.controls input:focus {
  border-color: var(--input-border);
  box-shadow: 0 0 0 2px var(--input-focus);
}

/* Dropdowns (dcc.Dropdown) */
.Select-control {
  background: var(--input-bg) !important;
  border-color: rgba(255,255,255,0.15) !important;
  color: var(--fg) !important;
}
.Select--single > .Select-control .Select-value,
.Select-placeholder {
  color: var(--fg) !important;
}
.Select-menu-outer {
  background: var(--input-bg) !important;
}

/* Buttons */
.controls button {
  background: var(--button-bg);
  color: var(--button-text);
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px 10px;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s, transform .02s;
}
.controls button:hover { background: var(--button-bg-hover); }
.controls button:active { transform: translateY(1px); }

/* Section spacing */
.controls + .controls {
  margin-top: 4px;
}

/* ===========================================================
   PLOT AREA
   =========================================================== */

#plot-wrap {
  width: min(100%, calc(100vh - 20px));
  aspect-ratio: 1 / 1;
  background: var(--graph-surface);
  border: 1px solid var(--graph-border);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 6px 18px rgba(0,0,0,0.25);
}

#plot {
  width: 100% !important;
  height: 100% !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* Plotly modebar readability */
.js-plotly-plot .modebar-btn path,
.js-plotly-plot .modebar-btn svg {
  fill: #ececf1 !important;
}

/* ===========================================================
   STATUS + DEBUG
   =========================================================== */

.status {
  color: var(--muted);
  margin: 6px 8px;
  font-size: 13px;
}

.debug {
  white-space: pre-wrap;
  color: #fca5a5;
  margin: 6px;
  font-size: 12px;
  opacity: 0.8;
}

/* ===========================================================
   CURSOR READOUT + INTERACTION
   =========================================================== */

.cursor-readout,
#cursor-readout {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12px;
  padding: 4px 8px;
  opacity: 0.85;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  user-select: none;
  white-space: pre;
}

/* ===========================================================
   RESPONSIVE
   =========================================================== */
@media (max-width: 900px) {
  .app {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
    height: auto;
  }
  .sidebar {
    max-height: none;
  }
  #plot-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
  }
}
