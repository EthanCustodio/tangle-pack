CLICK_SURFACE_NAME = "_click_surface"


def blank_figure():
    fig = go.Figure()
    fig.update_layout(
        clickmode="event+select",  # <-- REQUIRED so clickData is emitted
        dragmode="pan",
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(0,0,0,0)",
        margin=dict(l=40, r=10, t=10, b=40),
        xaxis=dict(
            showgrid=True,
            gridwidth=0.5,
            gridcolor="rgba(255,255,255,0.06)",
            zeroline=False,
        ),
        yaxis=dict(
            showgrid=True,
            gridwidth=0.5,
            gridcolor="rgba(255,255,255,0.06)",
            zeroline=False,
            scaleanchor="x",
            scaleratio=1,
        ),
        uirevision="keep",  # don't wipe pan/zoom on redraws
    )
    # Give the plot a starting window so the base trace has bounds
    fig.update_xaxes(range=[-15, 15])
    fig.update_yaxes(range=[-15, 15])

    # 🔑 PERMANENT FULL-CANVAS TRACE (like px.imshow). Stays at index 0.
    xr = fig.layout.xaxis.range or [-15, 15]
    yr = fig.layout.yaxis.range or [-15, 15]
    xs = np.linspace(xr[0], xr[1], 8)
    ys = np.linspace(yr[0], yr[1], 8)
    Z = np.zeros((len(ys), len(xs)))

    fig.add_trace(
        go.Heatmap(
            z=Z,
            x=xs,
            y=ys,
            showscale=False,
            hoverinfo="none",
            colorscale=[[0, "rgba(0,0,0,0)"], [1, "rgba(0,0,0,0)"]],
            opacity=0.001,  # invisible, but ALWAYS clickable
            name=CLICK_SURFACE_NAME,
            showlegend=False,
            zorder=0,
        )
    )

    return fig


