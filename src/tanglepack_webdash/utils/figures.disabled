def add_intersection_traces(workbench, fp, intersections, fig=None):
    """
    Add intersection points to a Plotly figure.
    """
    if fig is None:
        fig = go.Figure()
    elif not isinstance(fig, go.Figure):
        fig = go.Figure(fig)

    # intersections = workbench.compute_intersections(fp)
    # if not intersections:
    #     return fig

    arr = np.array(intersections)

    arr = np.array(list(workbench.Tangle._intersecting_coords.values()))
    if arr.size == 0:
        arr = workbench.compute_intersections(fp)
        if arr.size == 0:
            workbench.log.info("No intersections to plot.")
            return fig

    fig.add_trace(
        go.Scatter(
            x=arr[:, 0],
            y=arr[:, 1],
            mode="markers",
            name="Intersections",
            marker=dict(color="white", size=6),
            hovertemplate="x=%{x:.3f}<br>y=%{y:.3f}<extra>Intersection</extra>",
        )
    )
    return fig


def add_fp_trace(fig: go.Figure, x: float, y: float) -> go.Figure:
    fig.add_trace(
        go.Scattergl(
            x=[x],
            y=[y],
            mode="markers",
            marker=dict(size=9, color="white", line=dict(width=1, color="black")),
            name="FP",
            hovertemplate="FP: (%{x:.6f}, %{y:.6f})<extra></extra>",
        )
    )
    set_square_aspect(fig, True)
    return fig


def add_manifold_line(fig: go.Figure, arr: np.ndarray, *, color: str, name: str):
    """arr is (N,2) coordinates."""
    if arr.size == 0:
        return
    fig.add_trace(
        go.Scatter(
            x=arr[:, 0],
            y=arr[:, 1],
            mode="lines",
            line=dict(width=2, color=color),
            name=name,
            hoverinfo="none",
        )
    )


def add_bridges_only(state, fig=None):
    """
    Build a figure that shows ONLY: FP point, intersections, and bridge polylines.
    Regular manifolds are intentionally omitted.
    `state.bridges` should be a list of Bridge objects for the current FP.
    """
    if fig is None:
        fig = blank_figure()

    # 1) Fixed point
    if state.fp is not None:
        coords = np.asarray(state.fp.coordinates)
        pt = (
            coords[0]
            if (coords.ndim == 2 and coords.shape[1] == 2)
            else coords.reshape(-1)[:2]
        )
        add_fp_trace(fig, float(pt[0]), float(pt[1]))

    # 2) Intersections (as circles)
    intersections = np.array(list(state.workbench.Tangle._intersecting_coords.values()))
    if intersections.size == 0:
        intersections = state.workbench.compute_intersections(state.fp)
    add_intersection_traces(state.workbench, state.fp, intersections, fig)

    # 3) Stable Manifolds
    add_manifold_traces(state, state.fp, fig, "stable")

    # 3) Bridges (lines)
    bridges = getattr(state, "bridges", None) or []
    if bridges:
        palette = [
            "#1f77b4",
            "#ff7f0e",
            "#2ca02c",
            "#d62728",
            "#9467bd",
            "#8c564b",
            "#e377c2",
            "#7f7f7f",
            "#bcbd22",
            "#17becf",
            "#393b79",
            "#637939",
            "#8c6d31",
            "#843c39",
            "#7b4173",
            "#3182bd",
            "#e6550d",
            "#31a354",
            "#756bb1",
            "#636363",
        ]
        for i, B in enumerate(bridges):
            try:
                arr = B.get_point_array()  # (N,2) from BaseManifold
            except Exception:
                # Fallback: skip if no polyline yet
                continue
            if arr.size == 0:
                continue
            fig.add_trace(
                go.Scatter(
                    x=arr[:, 0],
                    y=arr[:, 1],
                    mode="lines",
                    line=dict(width=2, color=palette[i % len(palette)]),
                    name=f"Bridge {i+1}",
                    hoverinfo="skip",
                )
            )

    set_square_aspect(fig, True)
    return fig


def add_manifold_traces(state, fp, fig=None, stability=None):
    """
    Add stable and unstable manifolds for a fixed point to a plotly figure.

    Parameters
    ----------
    fp : FixedPoint
        The fixed point whose manifolds are to be drawn.
    fig : go.Figure, optional
        An existing figure. If None, creates a new blank one.

    Returns
    -------
    go.Figure
        The updated figure with manifold traces added.
    """
    if fig is None:
        fig = go.Figure()

    if stability is None:
        stabilities = ["unstable", "stable"]
    else:
        stabilities = [stability]

    workbench = state.workbench  # FixedPoint knows its workbench
    for (fixed, stab, _oi, _bi), manifold in workbench.manifolds.items():
        if fixed is not fp:
            continue
        arr = manifold.get_point_array()
        if arr.shape[0] < 2:
            continue  # nothing to draw yet
        if stab not in stabilities:
            continue

        color = "red" if stab == "stable" else "blue"
        fig.add_trace(
            go.Scatter(
                x=arr[:, 0],
                y=arr[:, 1],
                mode="lines+markers",
                name=f"{stab.capitalize()} manifold",
                line=dict(color=color),
                marker=dict(size=4, color=color),
            )
        )

    fig.update_layout(
        xaxis=dict(scaleanchor="y", title="x"),
        yaxis=dict(title="y"),
        showlegend=True,
    )
    return fig
